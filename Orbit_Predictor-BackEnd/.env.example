# Copy to .env and fill in. Never commit the filled-in file.

# Django settings
# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Required whenever DEBUG=False.
SECRET_KEY=your-secure-key-goes-here
DEBUG=True
# Comma separated. Required whenever DEBUG=False.
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
# DB_ENGINE=sqlite uses a local file and needs none of the settings below;
# anything else (the default) uses PostgreSQL.
DB_ENGINE=postgresql
DB_NAME=orbit_predictor
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# JWT Authentication
# Use a different value from SECRET_KEY. Required whenever DEBUG=False.
JWT_SECRET_KEY=your-jwt-secret-key-goes-here
ADMIN_REGISTRATION_CODE=your-admin-registration-code

# CORS: comma-separated origins allowed to call this API.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Email settings
# With DEBUG=True mail is printed to the console and these are unused.
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-password

# Logging: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
